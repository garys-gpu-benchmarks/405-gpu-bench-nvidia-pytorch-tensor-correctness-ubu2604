  {
    "field_name": "run_benchmark Command Plus Options for Smoke Run (One minute or less)",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "bash run_benchmark.sh --smoke --validate --device-id 0 --op-name matmul,conv2d --dtype f16_r --shape matmul=1x128x128;conv2d=1x3x32x32 --rtol 0.02 --atol 0.1 --num-iterations 2 --seed 42"
  },
  {
    "field_name": "run_benchmark Command Plus Options for Baseline Run (3 to 5 minutes)",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "bash run_benchmark.sh --baseline --validate --device-id 0 --op-name matmul,conv2d --dtype f16_r,bf16_r,f32_r --shape matmul=1x128x128,8x512x512;conv2d=1x3x32x32,8x3x64x64 --rtol f16_r=0.02,bf16_r=0.02,f32_r=1e-05 --atol f16_r=0.1,bf16_r=0.5,f32_r=1e-03 --num-iterations 50 --seed 42"
  },
  {
    "field_name": "run_benchmark Command Plus Options for Extended Run (8 to 15 minutes)",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "bash run_benchmark.sh --extended --validate --device-id 0 --op-name matmul,conv2d --dtype f16_r,bf16_r,f32_r --shape matmul=1x128x128,8x512x512;conv2d=1x3x32x32,8x3x64x64 --rtol f16_r=0.02,bf16_r=0.02,f32_r=1e-05 --atol f16_r=0.1,bf16_r=0.5,f32_r=1e-03 --num-iterations 100 --seed 42"
  },
