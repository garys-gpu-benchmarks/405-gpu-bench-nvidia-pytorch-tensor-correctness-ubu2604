    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "#1: Max absolute error across correctness cases (max_abs_error); #2: Maximum relative L2 error (max_rel_error); #3: Tolerance-compliant case percentage (tolerance_compliance); #4: Test case coverage count (coverage_count); #5: Test case failure count (failure_count)"
